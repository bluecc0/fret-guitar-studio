# Audiveris 启动文件。Mac 以实际安装路径为准；不能指向 .app 目录本身。
AUDIVERIS_BIN=/Applications/Audiveris.app/Contents/MacOS/Audiveris
AUDIVERIS_TIMEOUT=300
# 保持空白：不创建 Key，不发送 VLM 请求。
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=
# 从在线预览连接服务时，列入确切 Origin；默认服务仅监听 127.0.0.1。
FRET_ALLOWED_ORIGINS=https://fret-guitar-studio.jovialpark131.chatgpt.site
